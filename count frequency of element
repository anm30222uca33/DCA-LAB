#include <stdio.h>

int main() {
    int n, i, target, frequency = 0;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter the element to find its frequency: ");
    scanf("%d", &target);

    for (i = 0; i < n; i++) {
        if (arr[i] == target) {
            frequency++;
        }
    }

    printf("Frequency of %d = %d\n", target, frequency);

    return 0;
}
