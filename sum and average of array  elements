#include <stdio.h>

int main() {
    int n, i;
    double sum = 0, average;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        sum += arr[i];
    }

    average = sum / n;

    printf("Sum = %.2lf\n", sum);
    printf("Average = %.2lf\n", average);

    return 0;
}
